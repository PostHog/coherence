+// Whether the lexer, at an '&', stands at a character reference (&amp; &#123; &#x7B;). It consumes what it
+// reads; the caller has marked the end before the '&'.
+static bool at_character_reference(TSLexer *lexer) {
+    advance(lexer);
+    unsigned digits = 0;
+    if (lexer->lookahead == '#') {
+        advance(lexer);
+        if (lexer->lookahead == 'x' || lexer->lookahead == 'X') {
+            advance(lexer);
+            for (; digits < 6 && iswxdigit(lexer->lookahead); digits++) {
+                advance(lexer);
+            }
+        } else {
+            for (; digits < 5 && iswdigit(lexer->lookahead); digits++) {
+                advance(lexer);
+            }
+        }
+    } else {
+        for (; digits < 30 && ((lexer->lookahead >= 'a' && lexer->lookahead <= 'z') ||
+                               (lexer->lookahead >= 'A' && lexer->lookahead <= 'Z'));
+             digits++) {
+            advance(lexer);
+        }
+    }
+    return digits > 0 && lexer->lookahead == ';';
+}
+
 static bool scan_jsx_text(TSLexer *lexer) {
     // saw_text will be true if we see any non-whitespace content, or any whitespace content that is not a newline and
     // does not immediately follow a newline.
@@ -282,7 +318,18 @@ static bool scan_jsx_text(TSLexer *lexer) {
     bool at_newline = false;
 
     while (lexer->lookahead != 0 && lexer->lookahead != '<' && lexer->lookahead != '>' && lexer->lookahead != '{' &&
-           lexer->lookahead != '}' && lexer->lookahead != '&') {
+           lexer->lookahead != '}') {
+        if (lexer->lookahead == '&') {
+            // A character reference ends the text before it; a bare '&' (Billing & Usage) is text.
+            lexer->mark_end(lexer);
+            if (at_character_reference(lexer)) {
+                lexer->result_symbol = JSX_TEXT;
+                return saw_text;
+            }
+            saw_text = true;
+            at_newline = false;
+            continue;
+        }
         bool is_wspace = iswspace(lexer->lookahead);
         if (lexer->lookahead == '\n') {
             at_newline = true;
@@ -310,6 +357,7 @@ static bool scan_jsx_text(TSLexer *lexer) {
         advance(lexer);
     }
 
+    lexer->mark_end(lexer);
     lexer->result_symbol = JSX_TEXT;
     return saw_text;
 }
