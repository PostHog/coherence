+// Whether the lexer, at an '&', stands at a character reference (&amp; &#123; &#x7B;). It consumes what it
+// reads; the caller has marked the end before the '&'.
+static bool at_character_reference(TSLexer *lexer) {
+    advance(lexer);
+    unsigned digits = 0;
+    if (lexer->lookahead == '#') {
+        advance(lexer);
+        if (lexer->lookahead == 'x' || lexer->lookahead == 'X') {
+            advance(lexer);
+            for (; digits < 6 && iswxdigit(lexer->lookahead); digits++) {
+                advance(lexer);
+            }
+        } else {
+            for (; digits < 5 && iswdigit(lexer->lookahead); digits++) {
+                advance(lexer);
+            }
+        }
+    } else {
+        for (; digits < 30 && ((lexer->lookahead >= 'a' && lexer->lookahead <= 'z') ||
+                               (lexer->lookahead >= 'A' && lexer->lookahead <= 'Z'));
+             digits++) {
+            advance(lexer);
+        }
+    }
+    return digits > 0 && lexer->lookahead == ';';
+}
