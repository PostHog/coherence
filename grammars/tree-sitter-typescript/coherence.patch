+// Whether c is JavaScript's white space or a line terminator beyond ASCII, which ends a name as a space does.
+static bool is_unicode_space(int32_t c) {
+    return c == 0xA0 || c == 0x1680 || (c >= 0x2000 && c <= 0x200A) || c == 0x2028 || c == 0x2029 || c == 0x202F ||
+           c == 0x205F || c == 0x3000 || c == 0xFEFF;
+}
+
+// Whether c can continue an identifier, so `in` or `instanceof` before it is only a prefix of a longer
+// name (in_progress, $in, instanceId2), never the operator.
+static bool is_identifier_part(int32_t c) { return iswalnum(c) || c == '_' || c == '$' || c == '\\' || (c > 0x7F && !is_unicode_space(c)); }
