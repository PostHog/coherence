@@ -0,0 +1,94 @@
+==========================================
+Coherence: a bare ampersand in JSX text and strings
+==========================================
+
+const a = <p>Billing & Usage</p>;
+const b = <a to="x?a=1&b=2">x</a>;
+const c = <a title='Q&' data-x="R&" />;
+const d = <p title="x&amp;y">&amp; &#123; & {v}</p>;
+
+---
+
+(program
+  (lexical_declaration
+    (variable_declarator
+      (identifier)
+      (jsx_element
+        (jsx_opening_element
+          (identifier))
+        (jsx_text)
+        (jsx_closing_element
+          (identifier)))))
+  (lexical_declaration
+    (variable_declarator
+      (identifier)
+      (jsx_element
+        (jsx_opening_element
+          (identifier)
+          (jsx_attribute
+            (property_identifier)
+            (string
+              (string_fragment)
+              (string_fragment)
+              (string_fragment))))
+        (jsx_text)
+        (jsx_closing_element
+          (identifier)))))
+  (lexical_declaration
+    (variable_declarator
+      (identifier)
+      (jsx_self_closing_element
+        (identifier)
+        (jsx_attribute
+          (property_identifier)
+          (string
+            (string_fragment)
+            (string_fragment)))
+        (jsx_attribute
+          (property_identifier)
+          (string
+            (string_fragment)
+            (string_fragment))))))
+  (lexical_declaration
+    (variable_declarator
+      (identifier)
+      (jsx_element
+        (jsx_opening_element
+          (identifier)
+          (jsx_attribute
+            (property_identifier)
+            (string
+              (string_fragment)
+              (html_character_reference)
+              (string_fragment))))
+        (html_character_reference)
+        (jsx_text)
+        (html_character_reference)
+        (jsx_text)
+        (jsx_expression
+          (identifier))
+        (jsx_closing_element
+          (identifier))))))
+==========================================
+Coherence: character references at their limits
+==========================================
+
+const e = <p>&#x10FFFF;|&#x1234567;|&#12345;|&#123456;|&aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa;|&aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa;</p>;
+
+---
+
+(program
+  (lexical_declaration
+    (variable_declarator
+      (identifier)
+      (jsx_element
+        (jsx_opening_element
+          (identifier))
+        (html_character_reference)
+        (jsx_text)
+        (html_character_reference)
+        (jsx_text)
+        (html_character_reference)
+        (jsx_text)
+        (jsx_closing_element
+          (identifier))))))
