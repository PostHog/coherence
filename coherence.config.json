{
  "name": "coherence",
  "entryDir": ".",
  "ignore": ["node_modules", "promo"],
  "language": "typescript",
  "platform": "apple silicon",
  "wellKnown": ["Mnemion", "Sol"],
  "typecheck": ["npm", "run", "typecheck"],
  "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 --test-name-pattern={filter} 'src/**/*.test.ts'",
  "testMatch": "# pass [1-9][0-9]*",
  "testJson": [
    "node",
    "--disable-warning=ExperimentalWarning",
    "--test",
    "--test-concurrency=1",
    "--test-reporter=./src/enforcement/node-test-reporter.ts",
    "--test-reporter-destination={out}",
    "--test-name-pattern={filter}",
    "src/**/*.test.ts"
  ]
}
