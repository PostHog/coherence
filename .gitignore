node_modules/
.venv/
dist/
.DS_Store

# .coherence/ holds two different kinds of thing and they need opposite treatment.
# The record folders below are durable and cumulative: the journal's records, the
# verification runs, and the work orders. A fresh clone that started empty would
# have lost them. Everything else under .coherence is transient (the warm server's
# socket, feed cursors, read traces) and is regenerated on demand.
.coherence/*
!.coherence/journal/
!.coherence/runs/
!.coherence/work/

# agent worktrees
.claude/worktrees/

# The Scope reading is derived from docs/lexicon.json by `npm run scope`; derived output is computed, not stored.
public/_scope.html
