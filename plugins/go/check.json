    "go.mod": "module shop\n\ngo 1.22\n",
    "store/secrets.go": "package store\n\n// SecretColumns is the protected thing.\nvar SecretColumns = []string{\"token\"}\n\n// Seal is the chokepoint: the one way a row leaves without its secrets.\nfunc Seal(row map[string]string) map[string]string {\n\tout := map[string]string{}\n\tfor k, v := range row {\n\t\tout[k] = v\n\t}\n\tfor _, column := range SecretColumns {\n\t\tdelete(out, column)\n\t}\n\treturn out\n}\n",
    "store/rows.go": "package store\n\n// Row is one stored row.\ntype Row map[string]string\n\n// The store's bounds.\nconst (\n\tMaxRows = 100\n\tmaxCols = 8\n)\n",
    "api/render.go": "package api\n\nimport \"shop/store\"\n\n// Render seals the row, then reads the secret columns around the seal.\nfunc Render(row store.Row) int {\n\tsealed := store.Seal(row)\n\treturn len(sealed) + len(store.SecretColumns)\n}\n",
    "cmd/shop/main.go": "package main\n\nimport (\n\t\"fmt\"\n\t\"net/http\"\n\n\t\"shop/api\"\n\tst \"shop/store\"\n)\n\nfunc main() {\n\thttp.HandleFunc(\"/rows\", serveRow)\n\tfmt.Println(http.ListenAndServe(\":8080\", nil))\n}\n\n// serveRow renders the row a request names.\nfunc serveRow(w http.ResponseWriter, r *http.Request) {\n\trow := st.Row{\"id\": r.URL.Path}\n\tfmt.Fprint(w, api.Render(row))\n}\n",
    "store/secrets_test.go": "package store\n\nimport \"testing\"\n\nfunc TestColumns(t *testing.T) {\n\tif len(SecretColumns) == 0 {\n\t\tt.Fatal(\"no secret columns\")\n\t}\n}\n",
    "README.md": "# A module\n"
