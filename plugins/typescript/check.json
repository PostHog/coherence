    "src/store/rows.ts": "export interface Row {\n  id: string;\n}\n\nexport type RowId = string;\n\nconst LIMIT = 3;\n\nexport function first(rows: Row[]): Row[] {\n  return rows.slice(0, LIMIT);\n}\n",
