{
  "files": {
    "Counter.qnt": "// A counter that only climbs: the check project the Quint plugin is held to.\nmodule Counter {\n  var count: int\n\n  action init = count' = 0\n  action step = count' = count + 1\n\n  // Holds in every state: the count never goes below where it started.\n  val nonNegative = count >= 0\n  // Broken within three steps: the count passes 2.\n  val small = count < 3\n}\n",
    "coherence.config.json": "{\"quint\": {\"maxSamples\": 100, \"maxSteps\": 10, \"verifySteps\": 5}}\n",
    "README.md": "# A Quint check project\n"
  },
