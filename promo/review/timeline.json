   "src": "clips/read1-14-36-aba3b275698a.mp3",
   "adr": 0,
   "unread": false,
   "lead": 0.18
  },
  {
   "line": "37",
   "scene": 15,
   "text": "These are the kinds of tools we need to clear the fog.",
   "clip": "audio/adr/20260924-221619-take-mlv718qj/37.wav",
