   "adr": 0,
   "unread": false,
   "lead": 0.18
  },
  {
   "line": "27",
   "scene": 10,
   "text": "And decisions are never buried in a long transcript.",
   "clip": "audio/read1/10-27.wav",
   "at": 148.493,
