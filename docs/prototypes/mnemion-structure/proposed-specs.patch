+- {"kind": "relationship", "id": "browser-api", "from": "web", "to": "shared/Routing", "label": "Browses and edits memory", "because": "web/src/App.tsx loads /api/index and /api/query/:pattern and subscribes to /ws; views.tsx and FacetValue.tsx post edits to /api/mutate/:pattern. src/index.ts declares these endpoints with Auth.SESSION and Routing routes/pages.ts delegates them to Hive. The socket returns live changes over this same authenticated access surface."}
+- {"kind": "relationship", "id": "browser-vocabulary", "from": "shared/core", "to": "web", "label": "Defines browser renderers' vocabulary", "because": "web/src/views.tsx consumes ViewTypeId, resolveFormat, resolveChart and chartQuery from Core; FacetValue.tsx consumes FormatId and resolveFormat; Chart.tsx consumes the shared chart specification. The browser interprets the vocabulary whose validators the Hive also uses; this relationship describes shared declarations, not a proven parity guarantee."}
