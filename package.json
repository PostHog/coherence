{
  "name": "coherence",
  "version": "0.0.0",
  "private": true,
  "description": "A prosthetic for proprioception: specs, invariants, and the readings that keep an agent balanced.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "scope": "node --disable-warning=ExperimentalWarning src/cli.ts scope",
    "scope:check": "node --disable-warning=ExperimentalWarning --test src/readings/scope/check.test.ts",
    "journal:check": "node --disable-warning=ExperimentalWarning --test src/journal/journal.test.ts",
    "lexicon:check": "node --disable-warning=ExperimentalWarning src/cli.ts lexicon --check",
    "spec:check": "node --disable-warning=ExperimentalWarning src/cli.ts spec --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "test": "npm run typecheck && npm run test:unit && npm run lexicon:check && npm run spec:check",
    "test:setup": "\"${COHERENCE_PYTHON:-python3}\" -m venv .venv && .venv/bin/python -m pip install --requirement requirements-test.txt",
    "test:python": "node --disable-warning=ExperimentalWarning --test src/adapters/python.test.ts"
  },
  "devDependencies": {
    "@ibm/plex-mono": "2.5.0",
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3"
  },
  "bin": {
    "coherence": "src/cli.ts"
  },
  "optionalDependencies": {
    "node-llama-cpp": "3.21.1",
    "pyright": "^1.1.414",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0"
  }
}
