{
  "name": "@danilocampos/coherence",
  "version": "0.37.1",
  "description": "A spec + coherence harness for agent-developed projects: derive a multi-resolution graph from *.spec.md + code, render an explorable outline and an agent map, and verify claims/narrative/coverage. Language and platform specifics live behind adapters.",
  "license": "MIT",
  "author": "Danilo Campos <mail@danilocampos.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniloc/coherence.git"
  },
  "homepage": "https://github.com/daniloc/coherence#readme",
  "keywords": [
    "agents",
    "spec",
    "coherence",
    "claude-code",
    "codex",
    "harness",
    "verification"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "coherence": "dist/cli.js",
    "coherence-hook": "dist/hook-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "grammars",
    "docs/assays/posthog-guarantees-v0",
    "docs/assays/posthog-guarantees-r2",
    "docs/assays/posthog-guarantees-r3",
    "docs/assays/posthog-scope-v0",
    "docs/scope-extensions.md",
    "docs/scope.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-scope.mjs && chmod +x dist/cli.js dist/hook-cli.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@radix-ui/react-tabs": "1.1.21",
    "@types/node": "^22.0.0",
    "@xyflow/react": "12.11.6",
    "cytoscape": "3.34.2",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "web-tree-sitter": "^0.26.12"
  }
}
